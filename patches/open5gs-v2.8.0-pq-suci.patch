diff --git a/lib/sbi/conv.c b/lib/sbi/conv.c
index 4e7942b..98172bc 100644
--- a/lib/sbi/conv.c
+++ b/lib/sbi/conv.c
@@ -20,6 +20,117 @@
 #include "ogs-sbi.h"
 #include "yuarel.h"
 
+#include <time.h>
+#include <oqs/oqs.h>
+
+/*
+ * pq-suci-5g research prototype (NOT standardized): SUCI protection scheme 12,
+ * ML-KEM-768 KEM + the TS 33.501 Annex C DEM (X9.63 KDF, AES-128-CTR,
+ * HMAC-SHA-256/64). Scheme output = ct (1088 B) || AES-CTR(MSIN) || tag (8 B).
+ * KDF: Z = ML-KEM shared secret, SharedInfo = ct.
+ */
+#define PQ_MLKEM768_CT_LEN 1088
+#define PQ_MLKEM768_SS_LEN 32
+
+/* X9.63 KDF (SHA-256) for 64 output bytes with arbitrary-length SharedInfo.
+ * ogs_kdf_ansi_x963() only accepts z_len + 4 + info_len <= 69 bytes. */
+static void pq_kdf_ansi_x963(const uint8_t *z, size_t z_len,
+        const uint8_t *info, size_t info_len,
+        uint8_t *ek, uint8_t *icb, uint8_t *mk)
+{
+    uint8_t out[OGS_SHA256_DIGEST_SIZE * 2];
+    uint32_t counter;
+    int i;
+
+    for (i = 0; i < 2; i++) {
+        ogs_sha256_ctx ctx;
+
+        counter = htobe32(i + 1);
+        ogs_sha256_init(&ctx);
+        ogs_sha256_update(&ctx, z, z_len);
+        ogs_sha256_update(&ctx, (uint8_t *)&counter, sizeof(counter));
+        ogs_sha256_update(&ctx, info, info_len);
+        ogs_sha256_final(&ctx, out + i * OGS_SHA256_DIGEST_SIZE);
+    }
+    memcpy(ek, out, OGS_KEY_LEN);
+    memcpy(icb, out + OGS_KEY_LEN, OGS_IVEC_LEN);
+    memcpy(mk, out + OGS_KEY_LEN + OGS_IVEC_LEN, OGS_SHA256_DIGEST_SIZE);
+}
+
+static char *pq_mlkem768_supi_from_suci(const char *mcc, const char *mnc,
+        uint8_t pki, char *scheme_output_hex)
+{
+    size_t hex_len = strlen(scheme_output_hex);
+    size_t out_len = hex_len / 2, msin_len;
+    uint8_t *out = NULL, *plain = NULL;
+    char *bcd = NULL, *supi = NULL;
+    uint8_t ss[PQ_MLKEM768_SS_LEN];
+    uint8_t ek[OGS_KEY_LEN], icb[OGS_IVEC_LEN], mk[OGS_SHA256_DIGEST_SIZE];
+    uint8_t tag[OGS_MACTAG_LEN], diff = 0;
+    OQS_KEM *kem = NULL;
+    int i;
+
+    if (!ogs_sbi_self()->hnet[pki].avail ||
+        ogs_sbi_self()->hnet[pki].scheme !=
+            OGS_PROTECTION_SCHEME_PQ_MLKEM768 ||
+        !ogs_sbi_self()->hnet[pki].pq_key) {
+        ogs_error("[SIDF] no ML-KEM-768 key for PKI [%d]", pki);
+        return NULL;
+    }
+    if (hex_len % 2 || out_len <= PQ_MLKEM768_CT_LEN + OGS_MACTAG_LEN) {
+        ogs_error("[SIDF] scheme 12 output too short [%d]", (int)hex_len);
+        return NULL;
+    }
+    msin_len = out_len - PQ_MLKEM768_CT_LEN - OGS_MACTAG_LEN;
+
+    out = ogs_calloc(1, out_len);
+    ogs_assert(out);
+    ogs_ascii_to_hex(scheme_output_hex, hex_len, out, out_len);
+
+    kem = OQS_KEM_new(OQS_KEM_alg_ml_kem_768);
+    if (!kem || kem->length_ciphertext != PQ_MLKEM768_CT_LEN ||
+        kem->length_secret_key != ogs_sbi_self()->hnet[pki].pq_key_len) {
+        ogs_error("[SIDF] ML-KEM-768 unavailable or key size mismatch");
+        goto cleanup;
+    }
+    if (OQS_KEM_decaps(kem, ss, out,
+                ogs_sbi_self()->hnet[pki].pq_key) != OQS_SUCCESS) {
+        ogs_error("[SIDF] OQS_KEM_decaps() failed");
+        goto cleanup;
+    }
+
+    pq_kdf_ansi_x963(ss, sizeof(ss), out, PQ_MLKEM768_CT_LEN, ek, icb, mk);
+    ogs_hmac_sha256(mk, OGS_SHA256_DIGEST_SIZE,
+            out + PQ_MLKEM768_CT_LEN, msin_len, tag, OGS_MACTAG_LEN);
+    for (i = 0; i < OGS_MACTAG_LEN; i++)
+        diff |= tag[i] ^ out[PQ_MLKEM768_CT_LEN + msin_len + i];
+    if (diff) {
+        ogs_error("[SIDF] scheme 12 MAC-tag not matched");
+        goto cleanup;
+    }
+
+    plain = ogs_calloc(1, msin_len);
+    ogs_assert(plain);
+    ogs_aes_ctr128_encrypt(ek, icb, out + PQ_MLKEM768_CT_LEN, msin_len, plain);
+
+    bcd = ogs_calloc(1, msin_len * 2 + 1);
+    ogs_assert(bcd);
+    ogs_buffer_to_bcd(plain, msin_len, bcd);
+    supi = ogs_msprintf("imsi-%s%s%s", mcc, mnc, bcd);
+    ogs_assert(supi);
+
+cleanup:
+    OQS_MEM_cleanse(ss, sizeof(ss));
+    if (kem)
+        OQS_KEM_free(kem);
+    if (plain)
+        ogs_free(plain);
+    if (bcd)
+        ogs_free(bcd);
+    ogs_free(out);
+    return supi;
+}
