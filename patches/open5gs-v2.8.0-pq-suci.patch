+/* pq-suci-5g: read a raw binary ML-KEM secret key file into hnet[id] */
+static int load_pq_hnet_key(const char *filename, uint8_t id)
+{
+    FILE *fp = NULL;
+    long size;
+
+    fp = fopen(filename, "rb");
+    if (!fp) {
+        ogs_error("cannot open [%s]", filename);
+        return OGS_ERROR;
+    }
+    if (fseek(fp, 0, SEEK_END) != 0 || (size = ftell(fp)) <= 0 ||
+        fseek(fp, 0, SEEK_SET) != 0) {
+        fclose(fp);
+        return OGS_ERROR;
+    }
+    self.hnet[id].pq_key = ogs_malloc(size);
+    ogs_assert(self.hnet[id].pq_key);
+    if (fread(self.hnet[id].pq_key, 1, size, fp) != (size_t)size) {
+        ogs_free(self.hnet[id].pq_key);
+        self.hnet[id].pq_key = NULL;
+        fclose(fp);
+        return OGS_ERROR;
+    }
+    fclose(fp);
+    self.hnet[id].pq_key_len = size;
+    return OGS_OK;
+}
