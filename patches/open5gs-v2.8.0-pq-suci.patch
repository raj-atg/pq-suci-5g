+/* pq-suci-5g: time every SIDF de-concealment and log it for the experiments */
+char *ogs_supi_from_suci(char *suci)
+{
+    struct timespec t0, t1;
+    char *supi;
+    const char *p = suci;
+    int dashes = 0;
+
+    clock_gettime(CLOCK_MONOTONIC, &t0);
+    supi = supi_from_suci_impl(suci);
+    clock_gettime(CLOCK_MONOTONIC, &t1);
+
+    while (*p && dashes < 5)
+        if (*p++ == '-')
+            dashes++;
+    ogs_info("[SIDF] scheme=%d suci_len=%d supi=%s deconceal_us=%.1f",
+            atoi(p), (int)strlen(suci), supi ? supi : "FAILED",
+            (t1.tv_sec - t0.tv_sec) * 1e6 + (t1.tv_nsec - t0.tv_nsec) / 1e3);
+    return supi;
+}
