+std::string NasMm::generateSUCIProfileB(const std::string &msinDigits, const OctetString &hnPublicKey)
+{
+    if (hnPublicKey.length() != 33)
+    {
+        m_logger->err("Profile B needs a 33-byte compressed home network public key");
+        return {};
+    }
+    std::string out;
+    EVP_PKEY *eph = EVP_EC_gen("P-256");
+    EVP_PKEY *peer = nullptr;
+    EVP_PKEY_CTX *pctx = EVP_PKEY_CTX_new_from_name(nullptr, "EC", nullptr);
+    EVP_PKEY_CTX *dctx = nullptr;
+    char group[] = "prime256v1";
+    OSSL_PARAM params[] = {
+        OSSL_PARAM_construct_utf8_string(OSSL_PKEY_PARAM_GROUP_NAME, group, 0),
+        OSSL_PARAM_construct_octet_string(OSSL_PKEY_PARAM_PUB_KEY, const_cast<uint8_t *>(hnPublicKey.data()),
+                                          hnPublicKey.length()),
+        OSSL_PARAM_construct_end()};
+    uint8_t uncompressed[65], ephPub[33], z[32];
+    size_t uncompressedLen = 0, ephPubLen = sizeof(ephPub), zLen = sizeof(z);
+
+    // OpenSSL returns the uncompressed point (04 || x || y); compress it as 02/03 || x.
+    if (eph && pctx && EVP_PKEY_fromdata_init(pctx) == 1 &&
+        EVP_PKEY_fromdata(pctx, &peer, EVP_PKEY_PUBLIC_KEY, params) == 1 &&
+        EVP_PKEY_get_octet_string_param(eph, OSSL_PKEY_PARAM_ENCODED_PUBLIC_KEY, uncompressed,
+                                        sizeof(uncompressed), &uncompressedLen) == 1 &&
+        uncompressedLen == 65 && (dctx = EVP_PKEY_CTX_new(eph, nullptr)) && EVP_PKEY_derive_init(dctx) == 1 &&
+        EVP_PKEY_derive_set_peer(dctx, peer) == 1 && EVP_PKEY_derive(dctx, z, &zLen) == 1 && zLen == 32)
+    {
+        ephPub[0] = 0x02 | (uncompressed[64] & 1);
+        memcpy(ephPub + 1, uncompressed + 1, 32);
+        OctetString msin;
+        nas::EncodeBcdString(msin, msinDigits, ~0, false, 0);
+        OctetString schemeOutput = OctetString::FromArray(ephPub, ephPubLen);
+        schemeOutput.append(SuciDem(z, zLen, ephPub, ephPubLen, msin));
+        out = schemeOutput.toHexString();
+    }
+    EVP_PKEY_CTX_free(dctx);
+    EVP_PKEY_CTX_free(pctx);
+    EVP_PKEY_free(peer);
+    EVP_PKEY_free(eph);
+    return out;
+}
+
+std::string NasMm::generateSUCIPqMlkem768(const std::string &msinDigits, const OctetString &hnPublicKey)
+{
+    OQS_KEM *kem = OQS_KEM_new(OQS_KEM_alg_ml_kem_768);
+    if (!kem || hnPublicKey.length() != (int)kem->length_public_key)
+    {
+        m_logger->err("scheme 12 needs a %d-byte ML-KEM-768 public key", kem ? (int)kem->length_public_key : -1);
+        OQS_KEM_free(kem);
+        return {};
+    }
+    std::vector<uint8_t> ct(kem->length_ciphertext), ss(kem->length_shared_secret);
+    std::string out;
+    if (OQS_KEM_encaps(kem, ct.data(), ss.data(), hnPublicKey.data()) == OQS_SUCCESS)
+    {
+        OctetString msin;
+        nas::EncodeBcdString(msin, msinDigits, ~0, false, 0);
+        OctetString schemeOutput = OctetString::FromArray(ct.data(), ct.size());
+        schemeOutput.append(SuciDem(ss.data(), ss.size(), ct.data(), ct.size(), msin));
+        out = schemeOutput.toHexString();
+    }
+    OQS_MEM_cleanse(ss.data(), ss.size());
+    OQS_KEM_free(kem);
+    return out;
+}
