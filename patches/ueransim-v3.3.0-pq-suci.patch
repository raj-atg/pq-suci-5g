 // STEPHANE
 #include <iostream>
 
+// pq-suci-5g: Profile B and post-quantum scheme 12 (research prototype)
+#include <chrono>
+#include <openssl/core_names.h>
+#include <openssl/ec.h>
+#include <openssl/evp.h>
+#include <openssl/hmac.h>
+#include <openssl/params.h>
+#include <oqs/oqs.h>
+
+namespace
+{
+
+// TS 33.501 Annex C DEM: X9.63 KDF (SHA-256, 64 bytes) with any-length Z and SharedInfo,
+// then AES-128-CTR and HMAC-SHA-256 truncated to 64 bits. Returns ciphertext || tag,
+// or an empty string on error.
+OctetString SuciDem(const uint8_t *z, size_t zLen, const uint8_t *info, size_t infoLen,
+                    const OctetString &plain)
+{
+    uint8_t k[64];
+    for (uint32_t i = 0; i < 2; i++)
+    {
+        uint8_t counter[4] = {0, 0, 0, static_cast<uint8_t>(i + 1)};
+        EVP_MD_CTX *md = EVP_MD_CTX_new();
+        unsigned int len = 0;
+        EVP_DigestInit_ex(md, EVP_sha256(), nullptr);
+        EVP_DigestUpdate(md, z, zLen);
+        EVP_DigestUpdate(md, counter, sizeof(counter));
+        EVP_DigestUpdate(md, info, infoLen);
+        EVP_DigestFinal_ex(md, k + 32 * i, &len);
+        EVP_MD_CTX_free(md);
+    }
+
+    std::vector<uint8_t> ct(plain.length());
+    int outLen = 0;
+    EVP_CIPHER_CTX *c = EVP_CIPHER_CTX_new();
+    EVP_EncryptInit_ex(c, EVP_aes_128_ctr(), nullptr, k, k + 16);
+    EVP_EncryptUpdate(c, ct.data(), &outLen, plain.data(), plain.length());
+    EVP_CIPHER_CTX_free(c);
+
+    uint8_t mac[32];
+    unsigned int macLen = 0;
+    HMAC(EVP_sha256(), k + 32, 32, ct.data(), ct.size(), mac, &macLen);
+
+    OctetString out = OctetString::FromArray(ct.data(), ct.size());
+    out.append(OctetString::FromArray(mac, 8));
+    return out;
+}
+
+} // namespace
